# Copy to .env for local development. Placeholders only; never put secrets in this file.

# development | test | production
NODE_ENV=development

# Port the API listens on.
PORT=3000

# Comma-separated browser origins allowed to call the API.
# Defaults to the Vite dev (5173) and preview (4173) servers outside production; required in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Database (PostgreSQL; Neon for development) -------------------------------------------
# Both values are secrets: they contain the database password. Keep them only in backend/.env.
# In the Neon console, "Connect" shows both forms of the connection string for your branch.
#
# Runtime connection used by the API and the seed. On Neon: the POOLED string
# (host contains "-pooler"). Required when NODE_ENV=production: the API refuses to start without it
# (in development it starts anyway, and GET /api/v1/ready reports database "not_configured").
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/DBNAME?sslmode=verify-full"
#
# Used only by the Prisma CLI (migrate, db seed config, studio). On Neon: the DIRECT string
# (same host WITHOUT "-pooler"). Migrations need a direct, session-level connection.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-example.REGION.aws.neon.tech/DBNAME?sslmode=verify-full"

# --- Server ---------------------------------------------------------------------------------
# Reverse-proxy hops in front of the API (0 locally; e.g. 1 behind one load balancer).
TRUST_PROXY=0

# --- Payment simulator (Stage 2) ---------------------------------------------------------------
# Development-only FAKE payments (no money is taken or received; never revenue). Off by default.
# "true" is accepted ONLY with NODE_ENV=development: with any other NODE_ENV the API refuses to start.
# PAYMENT_SIMULATOR=true

# --- Booking confirmation (Revision 3) ---------------------------------------------------------
# manual (default, every environment): new bookings are AWAITING_CONFIRMATION until staff confirm them.
# payment: the Stage 2 simulator flow; accepted ONLY with NODE_ENV=development AND PAYMENT_SIMULATOR=true,
# otherwise the API refuses to start. This setting never turns the simulator on by itself.
# BOOKING_CONFIRMATION_MODE=manual

# --- Authentication (Stage 4A) ----------------------------------------------------------------
# disabled (default) | dev (local test identities; NODE_ENV=development + AUTH_DEV_LOGIN=true only) | cognito
AUTH_MODE=disabled
# AUTH_DEV_LOGIN=true
#
# Public origin of the website (where /api is served). Callback and post-logout URLs are built from it.
# Local: http://localhost:5173 (npm run dev) or http://localhost:4173 (npm run preview). Production: https only.
AUTH_PUBLIC_ORIGIN=http://localhost:5173
#
# SECRET. At least 32 random characters, e.g.: openssl rand -base64 48
SESSION_SECRET=
#
# Session lifetimes (defaults shown).
# SESSION_CUSTOMER_IDLE_MINUTES=720
# SESSION_CUSTOMER_ABSOLUTE_HOURS=168
# SESSION_ADMIN_IDLE_MINUTES=60
# SESSION_ADMIN_ABSOLUTE_HOURS=12
# AUTH_RATE_LIMIT_WINDOW_MINUTES=15
# AUTH_RATE_LIMIT_MAX=20
#
# AUTH_MODE=cognito: two DIFFERENT user pools, each with a confidential app client (client secret).
# Issuer: https://cognito-idp.REGION.amazonaws.com/USER_POOL_ID   Domain: the pool's managed-login domain.
# COGNITO_CUSTOMER_ISSUER=
# COGNITO_CUSTOMER_CLIENT_ID=
# COGNITO_CUSTOMER_CLIENT_SECRET=   # SECRET
# COGNITO_CUSTOMER_DOMAIN=
# COGNITO_ADMIN_ISSUER=
# COGNITO_ADMIN_CLIENT_ID=
# COGNITO_ADMIN_CLIENT_SECRET=      # SECRET
# COGNITO_ADMIN_DOMAIN=
