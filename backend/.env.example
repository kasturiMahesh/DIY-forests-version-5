# Copy to .env for local development. Placeholders only; never put secrets in this file.

# development | test | production
NODE_ENV=development

# Port the API listens on.
PORT=3000

# Comma-separated browser origins allowed to call the API.
# Defaults to the Vite dev (5173) and preview (4173) servers outside production; required in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Database (PostgreSQL; Neon for development) -------------------------------------------
# Both values are secrets: they contain the database password. Keep them only in backend/.env.
# In the Neon console, "Connect" shows both forms of the connection string for your branch.
#
# Runtime connection used by the API and the seed. On Neon: the POOLED string
# (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/DBNAME?sslmode=verify-full"
#
# Used only by the Prisma CLI (migrate, db seed config, studio). On Neon: the DIRECT string
# (same host WITHOUT "-pooler"). Migrations need a direct, session-level connection.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-example.REGION.aws.neon.tech/DBNAME?sslmode=verify-full"
