# Copy to .env for local development. Placeholders only; never put secrets in this file.

# development | test | production
NODE_ENV=development

# Port the API listens on.
PORT=3000

# Comma-separated browser origins allowed to call the API.
# Defaults to the Vite dev (5173) and preview (4173) servers outside production; required in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
