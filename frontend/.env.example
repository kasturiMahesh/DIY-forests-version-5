# Copy to .env.local to override. VITE_* values are compiled into the public JavaScript bundle:
# never put secrets here.

# Origin of the DIY Forests API, without a trailing slash or /api/v1, e.g. https://api.example.com
# Leave empty in local development: `npm run dev` / `npm run preview` proxy /api to http://localhost:3000.
VITE_API_BASE_URL=
